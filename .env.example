# ==========================================
# Spotify Profile Analyzer - Environment Configuration
# ==========================================

# Application
APP_NAME="Spotify Profile Analyzer"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

# Database (PostgreSQL for Docker, SQLite for Local)
DB_CONNECTION=sqlite
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=spotify_analytics
# DB_USERNAME=postgres
# DB_PASSWORD=postgres

# Sessions & Cache
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SAME_SITE=lax
CACHE_STORE=database

# Spotify Developer API Credentials
# Obtain at: https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here
SPOTIFY_REDIRECT_URI="${APP_URL}/api/spotify/callback"
